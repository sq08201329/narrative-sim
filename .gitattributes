# 换行符统一：仓库内一律存 LF，检出时按类型转换
* text=auto eol=lf

# 脚本：shell 必须 LF（git-bash 直接执行）；Windows 脚本保留 CRLF
*.sh text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 文本文件显式标注（便于 eol 统一与 diff 稳定）
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.cfg text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.example text eol=lf
*.sql text eol=lf
*.txt text eol=lf

# 二进制：不做换行转换
*.db binary
*.sqlite binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.xlsx binary
*.docx binary
*.pptx binary
*.pdf binary
*.zip binary
*.gz binary
