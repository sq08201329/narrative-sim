# DeepSeek Flash（OpenAI 兼容协议）—— M1 最小链路无需填值
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
MODEL_FAST=deepseek-flash
MODEL_SMART=deepseek-flash

# TinyTroupe 经 openai SDK 原生读取（M2 真后端必需）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com

# 嵌入服务（M3 语义记忆，OpenAI 兼容 /v1/embeddings，如本机 litert-lm）
# 未设置 EMBEDDING_API_BASE 时语义记忆自动降级为本地列表（只存不检），不阻塞仿真
EMBEDDING_API_BASE=
EMBEDDING_MODEL=eg2-text-270m.litertlm
EMBEDDING_TIMEOUT_S=10
EMBEDDING_MAX_CHARS=2000
