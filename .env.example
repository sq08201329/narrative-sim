# DeepSeek Flash（OpenAI 兼容协议）—— M1 最小链路无需填值
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
MODEL_FAST=deepseek-flash
MODEL_SMART=deepseek-flash

# TinyTroupe 经 openai SDK 原生读取（M2 真后端必需）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com

# 嵌入服务（M3 语义记忆，OpenAI 兼容 /v1/embeddings，如本机 litert-lm）
# 未设置 EMBEDDING_API_BASE 时语义记忆自动降级为本地列表（只存不检），不阻塞仿真
EMBEDDING_API_BASE=
EMBEDDING_MODEL=eg2-text-270m.litertlm
EMBEDDING_TIMEOUT_S=10
EMBEDDING_MAX_CHARS=2000

# 调研管线（M4 自动资产调研，MCP 客户端）
# gptr-mcp 服务端地址（streamable-http）；未设置时调研管线明确报错，不影响仿真
GPTR_MCP_URL=
RESEARCH_TIMEOUT_S=180
RESEARCH_DEDUP_THRESHOLD=0.85

# 调研溯源标签（005：gptr-mcp 服务端实际使用的检索腿标识）
GPTR_MCP_RETRIEVER_LABEL=gptr-mcp(deepseek-search)

# 立项调研纲领（009）
BRIEF_MAX_ITEMS=12
RESEARCH_SKIP_THRESHOLD=0.88
RESEARCH_ATTACH_THRESHOLD=0.80
RESEARCH_MATERIAL_MAX_CHARS=8000

# DM 裁判（010）—— 未启用 --dm 时无需关心；模型沿用 MODEL_FAST
DM_KNOWLEDGE_CHARS=2000
DM_MAX_CALLS=50
DM_TIMEOUT_S=30
